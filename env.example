# MCP Crypto Server Environment Configuration

# Database Configuration
NODE_ENV=production
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mcp_crypto

# PostgreSQL Configuration (dont change)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=mcp_crypto

# Telegram Configuration (Optional)
# Get session string from utils/telegram-auth.ts
TELEGRAM_SESSION_STRING=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Polymarket API Configuration
POLYMARKET_API_BASE_URL=https://gamma-api.polymarket.com

# CoinDesk API Configuration (Optional)
COINDESK_API_KEY=

# Pyth Network Configuration
PYTH_NETWORK_RPC_URL=https://api.mainnet-beta.solana.com
PYTH_NETWORK_CLUSTER=mainnet-beta

# Exchange API Keys #Disabled for now
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
BYBIT_API_KEY=
BYBIT_SECRET_KEY=

# Deribit API Configuration #Disabled for now
DERIBIT_CLIENT_ID=
DERIBIT_CLIENT_SECRET=

# OpenAI API Configuration (for strategy NL parser, summarization, semantic search)
OPENAI_API_KEY=

# Web Search (for research_search - pick one)
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=

# Solana (optional - defaults to public RPC)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Coinalyze API Configuration 
COINALYZE_API_KEY=

# Earnings Feed API (SEC filings, insider transactions, institutional holdings, company profiles)
# https://earningsfeed.com/api/docs
EARNINGSFEED_API_KEY=
EARNINGSFEED_API_BASE_URL=https://earningsfeed.com

# Massive / Polygon API (options & stocks - quotes, snapshots, OHLC)
# https://massive.com/docs
MASSIVE_API_KEY=
MASSIVE_API_BASE_URL=https://api.polygon.io

# Crypto News API (breaking crypto news, sentiment filtering)
# https://cryptonews-api.com/documentation
CRYPTO_NEWS_API_KEY=

LOG_LEVEL=info

# Server Configuration
PORT=3000
HOST=localhost
HEALTH_CHECK_INTERVAL=30000
POLYMARKET_SYNC_INTERVAL=86400000
TELEGRAM_SYNC_INTERVAL=3600000
MAX_CONCURRENT_REQUESTS=10
REQUEST_TIMEOUT=30000
API_RATE_LIMIT=100
POSTGRES_DB=mcpcrypto
LOG_LEVEL=info